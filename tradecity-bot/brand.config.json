{
    "brand_name": "TradeCity",
    "brand_domain": "tradecity.trade",
    "brand_hostname": {
        "staging": "staging.tradecity.trade",
        "production": "tradecity.trade"
    },
    "domain_name": "tradecity.trade",
    "colors": {
        "primary": "#ff444f",
        "secondary": "#85acb0",
        "tertiary": "#2dd4bf",
        "success": "#2dd4bf",
        "danger": "#ff444f",
        "warning": "#f59e0b",
        "info": "#0ea5e9",
        "neutral": "#94a3b8",
        "black": "#0c0e12",
        "white": "#ffffff",
        "grey": {
            "50": "#f4f6f8",
            "100": "#e5e7eb",
            "200": "#d1d5db",
            "300": "#94a3b8",
            "400": "#64748b",
            "500": "#475569",
            "600": "#334155",
            "700": "#2a3142",
            "800": "#141820",
            "900": "#0c0e12"
        }
    },
    "typography": {
        "font_family": {
            "primary": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
            "secondary": "'IBM Plex Sans', system-ui, sans-serif",
            "monospace": "'IBM Plex Mono', ui-monospace, monospace"
        },
        "font_sizes": {
            "xs": "0.75rem",
            "sm": "0.875rem",
            "base": "1rem",
            "lg": "1.125rem",
            "xl": "1.25rem",
            "2xl": "1.5rem",
            "3xl": "1.875rem",
            "4xl": "2.25rem"
        }
    },
    "color_variants": {
        "light_variants": [100, 200, 300, 400, 500],
        "dark_variants": [600, 700, 800, 900],
        "opacity_variants": [10, 20, 30, 40, 50, 60, 70, 80, 90]
    },
    "theme_config": {
        "enable_dynamic_themes": true,
        "auto_generate_variants": true,
        "css_variable_prefix": "--brand"
    },
    "platform": {
        "name": "TradeCity",
        "logo": {
            "type": "component",
            "component_name": "BrandLogo",
            "alt_text": "TradeCity",
            "link_url": "/",
            "show_text": true,
            "text": "TradeCity"
        },
        "footer": {
            "enable_language_settings": false,
            "enable_theme_toggle": true
        },
        "hostname": {
            "production": {
                "com": "tradecity.trade"
            },
            "staging": {
                "com": "staging.tradecity.trade"
            }
        },
        "auth2_url": {
            "production": "https://auth.deriv.com/oauth2/",
            "staging": "https://staging-auth.deriv.com/oauth2/"
        },
        "derivws": {
            "url": {
                "staging": "https://staging-api.derivws.com/trading/v1/",
                "production": "https://api.derivws.com/trading/v1/"
            },
            "directories": {
                "options": "options/",
                "derivatives": "derivatives/"
            }
        }
    }
}
