{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run install:bot && npm run build",
  "outputDirectory": "tradecity-bot/dist",
  "installCommand": "npm install --ignore-scripts",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!static|js|assets|smartcharts|favicon|manifest|service-worker|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
