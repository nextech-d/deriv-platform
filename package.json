{
  "name": "deriv-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:restart": "node scripts/dev-stop.mjs && node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=true playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pre-deploy": "bash scripts/pre-deploy.sh",
    "staging:up": "bash scripts/staging-up.sh",
    "staging:down": "bash scripts/staging-down.sh",
    "staging:smoke": "bash scripts/staging-smoke.sh"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "iron-session": "^8.0.4",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
