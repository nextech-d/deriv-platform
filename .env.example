# Deriv Application Manager — owner’s App ID (OAuth + WS + markup)
NEXT_PUBLIC_DERIV_APP_ID=

# Session encryption — min 32 chars; unique per environment
SESSION_SECRET=

# Set false in production; true for local demo / CI E2E
NEXT_PUBLIC_DEMO_MODE=true

# OAuth (optional — falls back to app ID for public PKCE clients)
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_SECRET=

# Sign up (new tab) — owner’s Deriv partner URL, or only the affiliate token (`t=`).
NEXT_PUBLIC_DERIV_SIGNUP_URL=
NEXT_PUBLIC_DERIV_AFFILIATE_TOKEN=
NEXT_PUBLIC_DERIV_UTM_CAMPAIGN=deriv_platform_ea

# Server-side API token — dev only; never set in production
DERIV_API_TOKEN=

# Error reporting (optional)
SENTRY_DSN=

# Partner studio (/admin) — bearer token for API writes
ADMIN_SECRET=

# Writable JSON paths for admin registries (optional — defaults under data/)
PARTNER_AGENTS_DATA_PATH=
COPY_PROVIDERS_DATA_PATH=
